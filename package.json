{
  "name": "campus-coin",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "npm run start --prefix server",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1 -Target all",
    "deploy:server": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1 -Target server",
    "deploy:client": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1 -Target client"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}

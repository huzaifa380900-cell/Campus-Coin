{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_ENV": "production",
    "CLIENT_URL": "http://localhost:5173,http://localhost:5173,http://localhost:5173"
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "**/*.{traineddata,wasm}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
